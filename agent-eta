#!/usr/bin/env python3
"""List every running agent session with its state and ETA, and its background tasks.

Claude Code, Codex and local goose runs work side by side, and each of them states an
ETA for a long or background command, but only as chat text. This tool turns that ETA
into one file per task and merges the files into a single list. See docs/agent-eta.md.

    agent-eta [list] [--json] [--tasks]
        Print every running session with its state (waiting, working or idle), its
        ETA and its background tasks underneath. Sessions waiting for an answer come
        first, then working ones by remaining time, then idle ones. --tasks prints the
        flat task list instead. Dead entries are pruned.

    agent-eta hook
        Hook entry point for Claude Code (PostToolUse on Bash) and Codex (PreToolUse and
        PostToolUse on Bash, plus UserPromptSubmit, PermissionRequest, Stop and
        Interrupt for the thread state). Reads the hook payload on stdin, always exits 0
        and never prints, so it can neither block nor alter a tool call.

    agent-eta turn --eta DUR [--label TEXT]
    agent-eta turn --done
        Set or clear the ETA of the calling session's current turn. It ends on its own
        when the turn does.

    agent-eta run --eta DUR [--label TEXT] [--agent NAME] -- CMD...
        Run CMD and list it for as long as it runs. For agents a hook does not reach.

    agent-eta add --eta DUR --label TEXT [--agent NAME] [--pid PID]
    agent-eta done ID...
        Record a wait that is not a local process, such as a CI pipeline, and remove it
        again. With --pid the entry lives exactly as long as that process.

The state lives in /tmp/agent-eta-<uid>, overridable with AGENT_ETA_DIR. /tmp is the only
directory that both the Codex sandbox and the host can write, and the files may vanish at
reboot, because every session they describe does too.

Every entry names a holder, which is how the reader decides on its own whether the task
still runs, so a forgotten `done` does not leave a ghost behind:

    pid   the process with this pid and this starttime still exists
    lock  the writer still holds an flock on the entry file, which works across the pid
          namespace the Codex sandbox puts every command into
    pair  the matching Codex PostToolUse has not deleted it yet, the Codex app-server it
          was recorded under still runs, and it is not past its expiry
    none  it is not past its expiry

Claude Code reports the state of every session in ~/.claude/sessions/<pid>.json itself.
Codex reports nothing outside its app, so its hooks keep one state file per thread in
sessions/ under the state directory.
"""

import argparse
import fcntl
import glob
import json
import os
import re
import secrets
import signal
import sqlite3
import stat
import subprocess
import sys
import time
from datetime import datetime
from zoneinfo import ZoneInfo

BERLIN = ZoneInfo("Europe/Berlin")
LABEL_MAX = 80
# Codex hands a command back to the model after a 10 second yield by default. Anything
# younger is an ordinary foreground command, and listing it would only make the list flicker.
CODEX_MIN_AGE = 10
# An entry without a live holder expires once it is overdue by its own length, but never
# sooner than this. One without any ETA expires after UNKNOWN_TTL.
OVERDUE_MIN = 3600
UNKNOWN_TTL = 2 * 3600
HOOK_LOG_MAX = 256 * 1024
# A Codex thread whose hooks stayed silent this long is dropped. One that claims to work or
# wait but stayed silent for SESSION_STALE most likely lost its Stop, and counts as idle.
SESSION_IDLE_TTL = 12 * 3600
SESSION_STALE = 6 * 3600
# An idle session without a running task counts as dormant after this long. Neither agent says
# whether anyone still looks at a session, and a process that lives on for days in a terminal
# tab or the Claude Code daemon looks just like one in use, so time is the signal.
DORMANT_AFTER = 12 * 3600
# The JSON section of a dormant session, after the three of section().
DORMANT_SECTION = 3
# Where PhpStorm projects live. A session below it belongs to the project at its first level.
PROJECTS_ROOT = "~/PhpstormProjects"
# How many processes up from a session's own one --json lists, for the tray to find its window.
LINEAGE_DEPTH = 12
# The line between the sections of the session table.
SECTION_RULE = "---"
# What an empty section of the session table says instead of its rows.
EMPTY_SECTIONS = ("(no waiting or idle sessions)", "(no working sessions)",
                  "(no sessions stopped by a usage limit)", "(no dormant sessions)")
# The same for the two sections of the usage table.
EMPTY_USAGE = ("(no usage limit with room left)", "(no usage limit reached)")
# Claude Code's own words for a session state, mapped to the three this list shows.
# "shell" is a foreground Bash command, measured against a running bash child on 2026-10-03.
CLAUDE_STATES = {"busy": "working", "shell": "working", "waiting": "waiting", "idle": "idle"}
# The Codex hook events that tell the state of a thread.
CODEX_STATES = {"UserPromptSubmit": "working", "PreToolUse": "working", "PostToolUse": "working",
                "PermissionRequest": "waiting", "Stop": "idle", "Interrupt": "idle"}
TURN_ENDS = ("UserPromptSubmit", "Stop", "Interrupt", "SessionEnd")
# Codex tools that put a question to the user. No hook sees them, and none sees a plan waiting
# for approval either, so the reader looks for both in the thread's rollout transcript.
# Measured on codex-cli 0.159.2.
CODEX_QUESTION_TOOLS = ("request_user_input",)
ROLLOUT_TAIL = 256 * 1024
# How long each Claude Code usage window lasts in minutes, by its name in usage-state.json.
CLAUDE_WINDOWS = {"five_hour": 300, "seven_day": 10080}
# How many of the most recently written Codex rollouts with a usage reading are searched for the
# latest one, and how many rollouts are opened at most to find them. Codex writes batches of
# short threads whose readings are all null, and those must not hide the last real one.
USAGE_ROLLOUTS = 5
USAGE_ROLLOUTS_MAX = 50
# How a Codex turn that ended with an error reads in the list, by its codex_error_info.
CODEX_ERRORS = {"usage_limit_exceeded": "usage limit"}
# Claude Code keeps a session's title in its transcript and rewrites it now and then. Only the
# end of a transcript is read first, because a long one runs to tens of megabytes.
TRANSCRIPT_TAIL = 2 * 1024 * 1024

UNITS = {}
for _seconds, _names in (
        (86400, "d day days tag tage"),
        (3600, "h hr hrs hour hours std stunde stunden"),
        (60, "m min mins minute minutes minute minuten"),
        (1, "s sec secs second seconds sek sekunde sekunden")):
    for _name in _names.split():
        UNITS[_name] = _seconds

_PART = re.compile(r"\s*(\d+(?:[.,]\d+)?)\s*([a-zäöü]+)\.?", re.I)
_SEP = re.compile(r"\s*(?:,|\bund\b|\band\b)?", re.I)
_BARE_MINUTES = re.compile(r"(\d{2})\b")
_MARKER = re.compile(r"(?:\bETA\b\s*:?\s*(?:ca\.\s*|~\s*)?|\bca\.\s*|\bungefähr\s+)", re.I)
_WRAPPED = re.compile(r"\bagent-eta\s+run\b")


class StateDirError(Exception):
    pass


# --- durations ------------------------------------------------------------------------

def scan_duration(text, pos=0):
    """Read a duration such as `1h30m` or `1 Stunde 30 Minuten` at pos.

    Returns (seconds, end), or (None, pos) when no duration starts there.
    """
    total, found = 0.0, False
    while True:
        match = _PART.match(text, pos)
        if not match or match.group(2).lower() not in UNITS:
            break
        unit = UNITS[match.group(2).lower()]
        total += float(match.group(1).replace(",", ".")) * unit
        found, pos = True, match.end()
        # `1h05` is the format the list itself prints, so it has to read back.
        if unit == 3600:
            bare = _BARE_MINUTES.match(text, pos)
            if bare:
                total += int(bare.group(1)) * 60
                pos = bare.end()
                break
        sep = _SEP.match(text, pos)
        following = _PART.match(text, sep.end())
        if not following or following.group(2).lower() not in UNITS:
            break
        pos = sep.end()
    return (int(round(total)), pos) if found else (None, pos)


def parse_eta_arg(text):
    """The --eta argument. A bare number is seconds, as for timeout(1)."""
    text = str(text).strip()
    if re.fullmatch(r"\d+", text):
        return int(text)
    marker = _MARKER.match(text)
    start = marker.end() if marker else 0
    seconds, end = scan_duration(text, start)
    if seconds is None or text[end:].strip():
        raise ValueError("not a duration: %r" % text)
    return seconds


def find_eta(text):
    """The first ETA a free text states, as (seconds, start, end), or None."""
    text = str(text or "")
    for marker in _MARKER.finditer(text):
        seconds, end = scan_duration(text, marker.end())
        if seconds is not None:
            return seconds, marker.start(), end
    return None


def format_span(seconds):
    """Remaining time as a short span: `<1m`, `4m`, `1h05`, `2d3h`, `-12m` or `?`."""
    if seconds is None:
        return "?"
    sign = "-" if seconds < 0 else ""
    left = abs(int(seconds))
    if not sign and left < 60:
        return "<1m"
    hours, minutes = divmod(left // 60, 60)
    if hours >= 24:
        return sign + "%dd%dh" % divmod(hours, 24)
    if hours:
        return sign + "%dh%02d" % (hours, minutes)
    return sign + "%dm" % minutes


def due_cell(remaining, due, now):
    """The DUE cell, which reads `?` wherever REMAINING does."""
    return "?" if remaining == "?" else format_due(due, now)


def format_due(due, now):
    if not due:
        return "-"
    moment = datetime.fromtimestamp(due, BERLIN)
    if abs(due - now) >= 86400:
        return moment.strftime("%d.%m. %H:%M")
    return moment.strftime("%H:%M")


# --- labels ---------------------------------------------------------------------------

def clip(text):
    text = " ".join(str(text or "").split())
    return text if len(text) <= LABEL_MAX else text[:LABEL_MAX - 1] + "…"


def strip_eta(text):
    """The text without the ETA it states, and without the brackets left around it."""
    found = find_eta(text)
    if not found:
        return text
    _, start, end = found
    text = text[:start] + text[end:]
    text = re.sub(r"\(\s*\)|\[\s*\]", "", text)
    return text.strip(" \t-–—,;:")


def command_label(command):
    """A shell command without its trailing `# ETA ...` comment."""
    command = str(command or "")
    hash_at = command.rfind("#")
    if hash_at >= 0 and find_eta(command[hash_at:]):
        command = command[:hash_at]
    return clip(command)


# --- processes ------------------------------------------------------------------------

def proc_start(pid):
    """Field 22 of /proc/<pid>/stat, the starttime in clock ticks, as Claude Code stores it."""
    try:
        with open("/proc/%d/stat" % int(pid), "r", encoding="utf-8", errors="replace") as handle:
            data = handle.read()
        return data.rsplit(")", 1)[1].split()[19]
    except (OSError, ValueError, IndexError, TypeError):
        return None


def pid_alive(pid, start=None):
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    except (OSError, ValueError, TypeError, OverflowError):
        return False
    return start is None or proc_start(pid) == str(start)


def parent_of(pid):
    try:
        with open("/proc/%d/stat" % pid, "r", encoding="utf-8", errors="replace") as handle:
            return int(handle.read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return None


def comm_of(pid):
    try:
        with open("/proc/%d/comm" % pid, "r", encoding="utf-8", errors="replace") as handle:
            return handle.read().strip()
    except OSError:
        return None


def lineage(pid, depth=LINEAGE_DEPTH):
    """The pid and its ancestors, nearest first, up to but without pid 1 and the user's systemd.
    The tray matches a window's pid against them, since a terminal or an IDE owns the window
    rather than the agent process itself."""
    found = []
    while pid and pid > 1 and len(found) < depth and comm_of(pid) not in (None, "systemd"):
        found.append(pid)
        pid = parent_of(pid)
    return found


def ancestor(match, start=None, depth=8):
    """The nearest ancestor pid for which match(pid) is true."""
    pid = parent_of(os.getpid()) if start is None else start
    for _ in range(depth):
        if not pid or pid <= 1:
            return None
        if match(pid):
            return pid
        pid = parent_of(pid)
    return None


def find_task_pid(task_id, proc="/proc"):
    """The top process of a Claude Code background task.

    Claude Code points fd 1 of a background shell at .../tasks/<task id>.output, and every
    child inherits it, so the earliest started of those processes is the shell itself.
    """
    suffix = "/tasks/%s.output" % task_id
    uid = os.getuid()
    best = None
    for name in os.listdir(proc):
        if not name.isdigit():
            continue
        try:
            if os.stat(os.path.join(proc, name)).st_uid != uid:
                continue
            if not os.readlink(os.path.join(proc, name, "fd", "1")).endswith(suffix):
                continue
        except OSError:
            continue
        start = proc_start(int(name))
        if start is None:
            continue
        if best is None or int(start) < int(best[1]):
            best = (int(name), start)
    return best


# --- state ----------------------------------------------------------------------------

def state_dir():
    path = os.environ.get("AGENT_ETA_DIR") or "/tmp/agent-eta-%d" % os.getuid()
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    info = os.lstat(path)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise StateDirError("%s is not a directory owned by uid %d" % (path, os.getuid()))
    if stat.S_IMODE(info.st_mode) & 0o077:
        os.chmod(path, 0o700)
    return path


def sub_dir(directory, name):
    """sessions/ or turns/ in the state directory, created on first write."""
    path = os.path.join(directory, name)
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    return path


def entry_path(directory, entry_id):
    return os.path.join(directory, entry_id + ".json")


def read_json(path):
    """A JSON object from path, or None when it is missing or not an object."""
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def json_files(folder):
    try:
        names = sorted(os.listdir(folder))
    except OSError:
        return []
    return [os.path.join(folder, name) for name in names if name.endswith(".json") and not name.startswith(".")]


def safe_id(text):
    return re.sub(r"[^A-Za-z0-9_.-]", "_", str(text))[:120]


def write_atomic(path, data):
    """Write JSON through a temporary file in the same directory, then rename.

    The reader may look at any moment, and a half-written entry would read as garbage.
    """
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(data, handle, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def write_locked(path, data):
    """Write an entry that lives as long as the returned file stays open.

    The lock is taken on the temporary file before the rename, so the entry is never
    visible unlocked.
    """
    tmp = "%s.tmp.%d" % (path, os.getpid())
    handle = open(tmp, "w", encoding="utf-8")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        json.dump(data, handle, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.replace(tmp, path)
    except BaseException:
        handle.close()
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return handle


def lock_held(path):
    try:
        handle = open(path, "r", encoding="utf-8")
    except OSError:
        return False
    with handle:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        except OSError:
            return False
        fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        return False


def remove(path):
    try:
        os.unlink(path)
        return True
    except FileNotFoundError:
        return False


def make_entry(entry_id, agent, label, eta, holder, source, session=None, cwd=None, now=None):
    now = time.time() if now is None else now
    return {
        "version": 1,
        "id": entry_id,
        "agent": agent,
        "session": session or {},
        "cwd": cwd or os.getcwd(),
        "label": clip(label),
        "started": int(now),
        "due": int(now + eta) if eta is not None else None,
        "source": source,
        "holder": holder,
    }


def expired(entry, now):
    started = entry.get("started") or now
    due = entry.get("due")
    if due:
        return now > due + max(OVERDUE_MIN, due - started)
    return now > started + UNKNOWN_TTL


def alive(entry, path, now):
    holder = entry.get("holder") or {}
    kind = holder.get("type")
    if kind == "pid":
        return pid_alive(holder.get("pid"), holder.get("start"))
    if kind == "lock":
        return lock_held(path)
    if kind == "pair":
        app = holder.get("app") or {}
        if app.get("pid") and not pid_alive(app["pid"], app.get("start")):
            return False
    return not expired(entry, now)


def load_entries(directory, now, prune=True):
    """Every live entry with its path. Dead and unreadable entries are deleted."""
    found = []
    for name in sorted(os.listdir(directory)):
        if not name.endswith(".json") or name.startswith("."):
            continue
        path = os.path.join(directory, name)
        try:
            with open(path, "r", encoding="utf-8") as handle:
                entry = json.load(handle)
            if not isinstance(entry, dict):
                raise ValueError("not an object")
        except FileNotFoundError:
            continue
        except (OSError, ValueError):
            if prune:
                remove(path)
            continue
        if alive(entry, path, now):
            found.append((entry, path))
        elif prune:
            remove(path)
    return found


# --- sessions -------------------------------------------------------------------------

def claude_home():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")


def claude_accounts():
    """Every Claude Code config directory to read, as (account, directory). With more than one
    account in the registry of scripts/claude-account, that is each registered account by its
    name, and otherwise the one directory of this environment without a name."""
    path = os.environ.get("CLAUDE_ACCOUNTS_FILE") or os.path.expanduser("~/.config/claude-account/accounts.json")
    data = read_json(path) or {}
    accounts = [a for a in data.get("accounts") or [] if isinstance(a, dict) and a.get("name") and a.get("dir")]
    if len(accounts) < 2:
        return [(None, claude_home())]
    return [(a["name"], os.path.expanduser(a["dir"])) for a in accounts]


def agent_label(agent, account):
    return "%s/%s" % (agent, account) if account else agent


def codex_home():
    return os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")


def claude_session(pid, home=None):
    """The registry record of a live Claude Code session, or {}. Without home it is looked up
    in every account's directory."""
    for directory in [home] if home else [directory for _, directory in claude_accounts()]:
        try:
            with open(os.path.join(directory, "sessions", "%d.json" % int(pid)), "r",
                      encoding="utf-8") as handle:
                record = json.load(handle)
        except (OSError, ValueError, TypeError):
            continue
        if not isinstance(record, dict):
            continue
        if record.get("procStart") and proc_start(pid) != str(record["procStart"]):
            continue
        return record
    return {}


def codex_threads():
    """Name and rollout path of every Codex thread, from the app's own state database.

    `name` is set once Codex has named a thread or the user renamed it. Until then the app
    shows the first prompt, which the database keeps as `title`, so its first line stands in.
    """
    paths = sorted(glob.glob(os.path.join(codex_home(), "state_*.sqlite")),
                   key=lambda path: int(re.sub(r"\D", "", os.path.basename(path)) or 0))
    if not paths:
        return {}
    threads = {}
    try:
        connection = sqlite3.connect("file:%s?mode=ro" % paths[-1], uri=True, timeout=1)
        try:
            for thread, name, title, rollout in connection.execute(
                    "SELECT id, name, title, rollout_path FROM threads"):
                first = next((line.strip() for line in str(title or "").splitlines() if line.strip()), "")
                threads[thread] = {"name": name or first.rstrip(":") or None, "rollout": rollout}
        finally:
            connection.close()
    except sqlite3.Error:
        return {}
    return threads


def codex_thread_names(threads=None):
    """Thread names by id, from session_index.jsonl and else from the state database."""
    threads = codex_threads() if threads is None else threads
    names = {thread: info["name"] for thread, info in threads.items() if info["name"]}
    try:
        with open(os.path.join(codex_home(), "session_index.jsonl"), "r", encoding="utf-8") as handle:
            for line in handle:
                try:
                    record = json.loads(line)
                except ValueError:
                    continue
                if isinstance(record, dict) and record.get("id") and record.get("thread_name"):
                    names[record["id"]] = record["thread_name"]
    except OSError:
        pass
    return names


def claude_title(session_id):
    """The latest custom or generated title in a Claude Code transcript, or None."""
    paths = [path for _, directory in claude_accounts()
             for path in glob.glob(os.path.join(directory, "projects", "*", "%s.jsonl" % glob.escape(str(session_id))))]
    if not paths:
        return None
    try:
        size = os.path.getsize(paths[0])
        with open(paths[0], "rb") as handle:
            for start in ((max(0, size - TRANSCRIPT_TAIL), 0) if size > TRANSCRIPT_TAIL else (0,)):
                handle.seek(start)
                titles = {}
                for line in handle.read(size - start).splitlines():
                    if b'-title"' not in line:
                        continue
                    try:
                        record = json.loads(line)
                    except ValueError:
                        continue
                    if record.get("type") == "custom-title" and record.get("customTitle"):
                        titles["custom"] = record["customTitle"]
                    elif record.get("type") == "ai-title" and record.get("aiTitle"):
                        titles["ai"] = record["aiTitle"]
                if titles:
                    return titles.get("custom") or titles.get("ai")
    except OSError:
        pass
    return None


def claude_name(record):
    """The name a Claude Code session shows. A name the registry only derived from the
    directory, such as `ai-0b`, gives way to the title in the transcript."""
    name = record.get("name")
    if record.get("nameSource") == "derived" or not name:
        name = claude_title(record.get("sessionId")) or name
    return name or os.path.basename(record.get("cwd") or "") or "-"


def claude_pid():
    try:
        pid = int(os.environ.get("CLAUDE_PID", ""))
        if pid_alive(pid):
            return pid
    except ValueError:
        pass
    sessions = os.path.join(claude_home(), "sessions")
    return ancestor(lambda pid: os.path.exists(os.path.join(sessions, "%d.json" % pid)))


def current_session():
    """Agent name and session of the process calling `run` or `add`."""
    codex_names = ("CODEX_THREAD_ID", "CODEX_SANDBOX", "CODEX_SANDBOX_NETWORK_DISABLED")
    if any(os.environ.get(name) for name in codex_names):
        return "codex", {"id": os.environ.get("CODEX_THREAD_ID")}
    if os.environ.get("CLAUDE_PID") or os.environ.get("CLAUDECODE"):
        pid = claude_pid()
        record = claude_session(pid, claude_home()) if pid else {}
        return "claude", {"id": os.environ.get("CLAUDE_CODE_SESSION_ID") or record.get("sessionId"),
                          "pid": pid, "name": record.get("name")}
    return "other", {}


def session_name(entry, thread_names):
    session = entry.get("session") or {}
    if entry.get("agent") == "claude" and session.get("pid"):
        record = claude_session(session["pid"])
        if record:
            return claude_name(record)
    if entry.get("agent") == "codex" and session.get("id"):
        name = thread_names.get(session["id"])
        if name:
            return name
    return session.get("name") or os.path.basename(entry.get("cwd") or "") or "-"


def claude_sessions():
    """Every live Claude Code session of every account, with the state Claude Code writes to its
    registry."""
    found = []
    for account, directory in claude_accounts():
        found.extend(account_sessions(account, directory))
    return found


def account_sessions(account, directory):
    found = []
    for path in json_files(os.path.join(directory, "sessions")):
        name = os.path.basename(path)[:-5]
        if not name.isdigit() or not pid_alive(int(name)):
            continue
        pid = int(name)
        record = claude_session(pid, directory)
        if not record:
            continue
        status = record.get("status")
        since = record.get("statusUpdatedAt") or record.get("startedAt")
        found.append({
            "agent": "claude",
            "account": account,
            "id": record.get("sessionId"),
            "pid": pid,
            "name": claude_name(record),
            "state": CLAUDE_STATES.get(status, status or "unknown"),
            "waiting_for": record.get("waitingFor") if status == "waiting" else None,
            "since": since / 1000 if isinstance(since, (int, float)) else None,
            "cwd": record.get("cwd"),
        })
    return found


def codex_session_path(directory, thread):
    return os.path.join(sub_dir(directory, "sessions"), "codex-%s.json" % safe_id(thread))


def codex_rollout(thread, hint=None):
    """The rollout transcript of a Codex thread, from the hook payload or by its file name."""
    if hint and os.path.isfile(hint):
        return hint
    pattern = os.path.join(codex_home(), "sessions", "*", "*", "*", "rollout-*-%s.jsonl" % glob.escape(thread))
    matches = glob.glob(pattern)
    return max(matches) if matches else None


def parse_stamp(text):
    try:
        return datetime.fromisoformat(str(text).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def tail_records(path, size=ROLLOUT_TAIL):
    """The records at the end of a rollout transcript that carry a payload object, or None
    when the file cannot be read."""
    try:
        with open(path, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - size))
            data = handle.read()
    except (OSError, TypeError):
        return None
    records = []
    for line in data.splitlines():
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict) and isinstance(record.get("payload"), dict):
            records.append(record)
    return records


def codex_pending(path):
    """What a Codex thread waits for according to its transcript, as (reason, since), or None.

    Reads the end of the rollout transcript. A tool call is a `response_item` and its answer
    follows as the matching `*_output` with the same call_id, so a `request_user_input` call
    without one is an open question. In plan mode a turn ends with an `item_completed` event of
    type `Plan` before its `task_complete`, and the app then asks whether to implement the plan,
    so a last finished turn that carries a plan waits for its approval.
    """
    records = tail_records(path)
    if records is None:
        return None
    asked, planned, finished, resets = {}, set(), None, None
    for record in records:
        payload = record["payload"]
        kind = payload.get("type")
        if record.get("type") == "response_item":
            if kind in ("function_call", "custom_tool_call") and payload.get("name") in CODEX_QUESTION_TOOLS:
                asked[payload.get("call_id")] = record.get("timestamp")
            elif kind in ("function_call_output", "custom_tool_call_output"):
                asked.pop(payload.get("call_id"), None)
            elif kind == "message" and payload.get("role") == "user":
                finished = None
        elif record.get("type") == "event_msg":
            if kind == "item_completed" and (payload.get("item") or {}).get("type") == "Plan":
                planned.add(payload.get("turn_id"))
            elif kind == "task_complete":
                finished = (payload.get("turn_id"), record.get("timestamp"), payload.get("error"))
            elif kind in ("task_started", "user_message"):
                finished = None
            elif kind == "token_count":
                resets = exhausted_until(payload.get("rate_limits")) or resets
    if asked:
        return "question", parse_stamp(list(asked.values())[-1]) or 0, None
    if finished and isinstance(finished[2], dict):
        code = str(finished[2].get("codex_error_info") or "error")
        reason = CODEX_ERRORS.get(code, code.replace("_", " "))
        return reason, parse_stamp(finished[1]) or 0, resets if code == "usage_limit_exceeded" else None
    if finished and finished[0] in planned:
        return "plan approval", parse_stamp(finished[1]) or 0, None
    return None


def codex_permission_answered(path, since):
    """When the permission request a Codex thread raised at `since` was answered, or None.

    Code mode runs every command inside a script, which the transcript records as a tool call.
    The script's output can only follow once each approval inside it was decided, by the user
    or by the auto-review agent, so the output of the call open at the request answers it. The
    hook stamps `since` in whole seconds, hence the one second of slack. Without that call in the
    transcript the request stays open.
    """
    records = tail_records(path)
    if not records:
        return None
    call, outputs = None, {}
    for record in records:
        payload = record["payload"]
        if record.get("type") != "response_item":
            continue
        stamp = parse_stamp(record.get("timestamp"))
        if stamp is None:
            continue
        kind = payload.get("type")
        if kind in ("function_call", "custom_tool_call") and stamp <= since + 1:
            call = payload.get("call_id")
        elif kind in ("function_call_output", "custom_tool_call_output"):
            outputs[payload.get("call_id")] = stamp
    return outputs.get(call) if call else None


def exhausted_until(limits):
    """When the latest exhausted Codex usage window resets, from a token_count rate_limits record.

    A record without window data, such as the one Codex writes right after a limit was hit,
    yields None, so the reader keeps the value of the record before it.
    """
    if not isinstance(limits, dict):
        return None
    windows = [limits.get("primary"), limits.get("secondary")]
    if not any(isinstance(window, dict) for window in windows):
        return None
    resets = [window.get("resets_at") for window in windows
              if isinstance(window, dict) and (window.get("used_percent") or 0) >= 100 and window.get("resets_at")]
    return max(resets) if resets else 0


def codex_sessions(directory, now, names, prune=True, threads=None):
    """Every Codex thread its hooks have reported, while its app-server runs.

    A thread whose hooks stayed silent for SESSION_IDLE_TTL is dropped, and one that has
    claimed to work or wait for SESSION_STALE without a word counts as idle. A thread that is
    not idle and has an unanswered question in its transcript waits for that answer.
    """
    found = []
    for path in json_files(os.path.join(directory, "sessions")):
        record = read_json(path)
        app = (record or {}).get("app") or {}
        updated = (record or {}).get("updated") or 0
        if (record is None or not record.get("id") or now - updated > SESSION_IDLE_TTL
                or (app.get("pid") and not pid_alive(app["pid"], app.get("start")))):
            if prune:
                remove(path)
            continue
        state, since = record.get("state") or "unknown", record.get("since")
        waiting_for = record.get("waiting_for")
        if threads is None:
            threads = codex_threads()
        hint = record.get("transcript") or (threads.get(record["id"]) or {}).get("rollout")
        rollout = codex_rollout(record["id"], hint)
        pending = codex_pending(rollout)
        resume_at = None
        # PermissionRequest sets waiting and only the next hook call clears it, which can be
        # minutes after the auto-review agent or the user decided.
        if state == "waiting" and waiting_for == "permission":
            answered = codex_permission_answered(rollout, since or updated)
            if answered:
                state, since, waiting_for = "working", answered, None
        # A turn that ended with an error fires no Stop hook, so the transcript decides on its own.
        # An open question only counts inside a turn, and a plan only once its turn has ended.
        if pending and pending[2] and pending[2] <= now:
            # The usage limit has reset, so the thread only waits for its next prompt.
            state, since = "idle", pending[2]
        elif pending and pending[0] not in ("question", "plan approval"):
            state, since, waiting_for, resume_at = "stopped", pending[1] or since, pending[0], pending[2]
        elif pending and (pending[0] == "question") == (state != "idle"):
            state, since, waiting_for = "waiting", pending[1] or since, pending[0]
        elif state != "idle" and now - updated > SESSION_STALE:
            state, since = "idle", updated
        found.append({
            "agent": "codex",
            "id": record["id"],
            "pid": None,
            "name": names.get(record["id"]) or os.path.basename(record.get("cwd") or "") or "-",
            "state": state,
            "waiting_for": waiting_for if state in ("waiting", "stopped") else None,
            "since": since,
            "cwd": record.get("cwd"),
            "resume_at": resume_at,
        })
    return found


def claude_usage():
    """The Claude Code usage windows of every account as scripts/claude-usage/statusline.py last
    recorded them, each account as an agent of its own."""
    found = []
    for account, directory in claude_accounts():
        state = read_json(os.path.join(directory, "usage-state.json")) or {}
        windows = state.get("windows") if isinstance(state.get("windows"), dict) else {}
        for name, minutes in CLAUDE_WINDOWS.items():
            window = windows.get(name)
            if isinstance(window, dict) and isinstance(window.get("used_percentage"), (int, float)):
                found.append(usage_window(agent_label("claude", account), minutes, window["used_percentage"],
                                          window.get("resets_at"), state.get("windows_seen_at")))
    return found


def codex_usage():
    """The Codex usage windows of the latest `token_count` reading that carries windows, from
    the most recently written rollout transcripts that hold such a reading."""
    pattern = os.path.join(codex_home(), "sessions", "*", "*", "*", "rollout-*.jsonl")
    paths = sorted(glob.glob(pattern), key=modified, reverse=True)[:USAGE_ROLLOUTS_MAX]
    seen_at, limits, found = 0, None, 0
    for path in paths:
        if found >= USAGE_ROLLOUTS:
            break
        held = False
        for record in tail_records(path) or []:
            payload = record["payload"]
            reading = payload.get("rate_limits") if payload.get("type") == "token_count" else None
            if not isinstance(reading, dict):
                continue
            if not any(isinstance(reading.get(key), dict) for key in ("primary", "secondary")):
                continue
            stamp = parse_stamp(record.get("timestamp")) or 0
            if stamp >= seen_at:
                seen_at, limits = stamp, reading
            held = True
        found += held
    if not limits:
        return []
    return [usage_window("codex", window["window_minutes"], window["used_percent"], window.get("resets_at"),
                         seen_at)
            for window in (limits.get("primary"), limits.get("secondary"))
            if isinstance(window, dict) and window.get("window_minutes")
            and isinstance(window.get("used_percent"), (int, float))]


def modified(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return 0


def usage_window(agent, minutes, used, resets_at, seen_at):
    return {"agent": agent, "minutes": int(minutes), "used": float(used), "resets_at": resets_at,
            "seen_at": seen_at}


def usage_view(now):
    """Every usage window with the share of it that has passed, both in percent, how far the
    usage runs ahead of the time in percentage points, the time left until its reset and
    whether its limit is reached. A window whose reset lies in the past has started over since
    its reading, so none of that is known then."""
    windows = claude_usage() + codex_usage()
    for window in windows:
        resets_at, length = window["resets_at"], window["minutes"] * 60
        if resets_at and resets_at > now:
            window["elapsed"] = max(0.0, min(100.0, 100.0 * (1 - (resets_at - now) / length)))
            window["pace"] = window["used"] - window["elapsed"]
            window["remaining"] = int(resets_at - now)
        else:
            window["used"] = window["elapsed"] = window["pace"] = window["remaining"] = None
        window["ahead"] = window["pace"] is not None and window["pace"] > 0
        window["reached"] = window["used"] is not None and window["used"] >= 100
    return windows


def usage_sections(windows):
    """The agents whose usage limits all have room left and the agents with a reached limit, each
    with the soonest reset first and their windows in the same order. Each entry is (agent,
    summary, windows). The summary of an open agent is its window that resets first, and that of
    a blocked one the reached window that resets last, since that reset ends the block."""
    def until_reset(window):
        return (window["remaining"] is None, window["remaining"] or 0)
    by_agent = {}
    for window in windows:
        by_agent.setdefault(window["agent"], []).append(window)
    open_, blocked = [], []
    for agent, group in by_agent.items():
        group.sort(key=until_reset)
        reached = [window for window in group if window["reached"]]
        if reached:
            blocked.append((agent, max(reached, key=lambda window: window["remaining"]), group))
        else:
            open_.append((agent, group[0], group))
    for entries in (open_, blocked):
        entries.sort(key=lambda entry: until_reset(entry[1]))
    return open_, blocked


def render_usage(windows, now):
    """The usage table in two sections, agents with room left in every window and agents with a
    reached limit. Each agent's row holds the worst of its windows per column, and its windows
    follow as `└` rows. PACE is the usage ahead of the time in percentage points, REMAINING and
    DUE say when a window resets, and READ how old the reading is."""
    sections = usage_sections(windows)
    lines = [("USAGE", "USED", "ELAPSED", "PACE", "REMAINING", "DUE", "READ")]
    blocks = []
    for entries in sections:
        block = []
        for agent, summary, group in entries:
            age = format_span(now - summary["seen_at"]) if summary.get("seen_at") else "?"
            block.append((agent,) + agent_cells(summary, group, now) + (age,))
            block.extend(("└ " + format_window(window["minutes"]),) + usage_cells(window, now) + ("",)
                         for window in group)
        blocks.append(block)
    widths = [max(len(line[i]) for line in lines + sum(blocks, [])) for i in range(len(lines[0]))]
    def row(line):
        return "  ".join(cell.ljust(widths[i]) for i, cell in enumerate(line)).rstrip()
    text = [row(lines[0])]
    for index, block in enumerate(blocks):
        if index:
            text.append(SECTION_RULE)
        if block:
            text.extend(row(line) for line in block)
        else:
            text.append(EMPTY_USAGE[index])
    return "\n".join(text) + "\n"


def agent_cells(summary, group, now):
    """USED, ELAPSED, PACE, REMAINING and DUE of an agent's row. USED is its highest used share and
    PACE its worst pace, each from whichever window holds it, so ELAPSED belongs to no single
    window and stays blank. REMAINING and DUE are those of the summary window, which orders the
    agents."""
    known = [window for window in group if window["pace"] is not None]
    if not known:
        return ("?", "-", "?", "?", "?")
    worst = max(known, key=lambda window: window["pace"])
    used = max(window["used"] for window in known)
    reset = usage_cells(summary, now)[3:]
    return (percent(used), "-", usage_cells(worst, now)[2]) + reset


def usage_cells(window, now):
    """USED, ELAPSED, PACE, REMAINING and DUE of one usage window."""
    if window["elapsed"] is None:
        return (percent(window["used"]), "?", "?", "?", "?")
    pace = "%s %+d%%" % ("ahead" if window["ahead"] else "ok", round(window["pace"]))
    return (percent(window["used"]), percent(window["elapsed"]), pace, format_span(window["remaining"]),
            format_due(window["resets_at"], now))


def format_window(minutes):
    """A window length as `5h` or `7d`."""
    if minutes % 1440 == 0:
        return "%dd" % (minutes // 1440)
    if minutes % 60 == 0:
        return "%dh" % (minutes // 60)
    return "%dm" % minutes


def percent(value):
    return "?" if value is None else "%d%%" % round(value)


def session_key(agent, session):
    """Claude Code sessions are matched by pid, which survives a /clear, Codex threads by id."""
    if agent == "claude" and session.get("pid"):
        return ("claude", int(session["pid"]))
    if session.get("id"):
        return (agent, session["id"])
    return None


def turn_path(directory, agent, session):
    key = session_key(agent, session)
    return os.path.join(sub_dir(directory, "turns"), "%s-%s.json" % (key[0], safe_id(key[1])))


def load_turns(directory, now, sessions, prune=True):
    """The turn ETA of every session by session key. A turn whose session went idle or
    stopped is over."""
    by_key = {session_key(s["agent"], s): s for s in sessions}
    found = {}
    for path in json_files(os.path.join(directory, "turns")):
        record = read_json(path)
        key = session_key(record.get("agent"), record.get("session") or {}) if record else None
        owner = by_key.get(key)
        ended = (owner is None or expired(record, now)
                 or (owner["state"] in ("idle", "stopped")
                     and (owner["since"] or 0) >= (record.get("started") or 0)))
        if ended:
            if prune:
                remove(path)
            continue
        found[key] = record
    return found


# --- list -----------------------------------------------------------------------------

def progress(started, due, now):
    """The share of the time from started to due that has passed, from 0 to 1, or None without a
    due time. An overdue ETA stays at 1, and `overdue` says that it ran over."""
    if not due:
        return None
    if not started or due <= started:
        return 1.0 if now >= due else 0.0
    return max(0.0, min(1.0, (now - started) / (due - started)))


def visible(entry, now):
    if entry.get("agent") == "codex" and entry.get("source") == "hook":
        return now - (entry.get("started") or now) >= CODEX_MIN_AGE
    return True


def rows(directory, now):
    entries = [entry for entry, _ in load_entries(directory, now) if visible(entry, now)]
    names = codex_thread_names() if any(e.get("agent") == "codex" for e in entries) else {}
    result = []
    for entry in entries:
        due = entry.get("due")
        remaining = int(due - now) if due else None
        row = dict(entry)
        row["remaining"] = remaining
        row["overdue"] = remaining is not None and remaining < 0
        row["progress"] = progress(entry.get("started"), due, now)
        row["session_name"] = session_name(entry, names)
        result.append(row)
    return sorted(result, key=sort_key)


def sort_key(row):
    remaining = row["remaining"]
    if remaining is None:
        return (2, row.get("started") or 0)
    return (0 if remaining < 0 else 1, remaining)


def render(table, now):
    if not table:
        return "No background tasks.\n"
    lines = [("REMAINING", "DUE", "AGENT", "SESSION", "TASK")]
    for row in table:
        lines.append((format_span(row["remaining"]), due_cell(format_span(row["remaining"]), row.get("due"), now),
                      row.get("agent") or "-", clip(row["session_name"])[:28], row.get("label") or "-"))
    widths = [max(len(line[i]) for line in lines) for i in range(4)]
    out = []
    for line in lines:
        out.append("  ".join(cell.ljust(widths[i]) for i, cell in enumerate(line[:4])) + "  " + line[4])
    return "\n".join(out) + "\n"


def sessions_view(directory, now, tasks=None, usage=None):
    """Every running session with its state, its ETA and its tasks, in display order.

    The ETA of a session is the turn ETA its agent set with `agent-eta turn`, or else the
    latest due time among its tasks. A task whose session is not known, such as a local run,
    stands as a session of its own. A Codex command from before its thread stopped never gets
    its PostToolUse, so its entry is deleted here. A session that does not work while its
    account has a reached usage limit counts as stopped until that limit resets.
    """
    tasks = rows(directory, now) if tasks is None else tasks
    threads = codex_threads()
    names = codex_thread_names(threads)
    sessions = claude_sessions() + codex_sessions(directory, now, names, threads=threads)
    turns = load_turns(directory, now, sessions)
    by_key = {}
    for session in sessions:
        session["tasks"] = []
        by_key[session_key(session["agent"], session)] = session
    kept = []
    for task in tasks:
        key = session_key(task.get("agent"), task.get("session") or {}) or ("task", task["id"])
        owner = by_key.get(key)
        if owner and stopped_before(owner, task):
            remove(entry_path(directory, task["id"]))
            continue
        kept.append(task)
        if owner is None:
            session = task.get("session") or {}
            owner = by_key[key] = {
                "agent": task.get("agent"), "id": session.get("id"), "pid": session.get("pid"),
                "name": task["session_name"], "state": "working" if task.get("agent") != "other" else "-",
                "waiting_for": None, "since": task.get("started"), "cwd": task.get("cwd"), "tasks": []}
            sessions.append(owner)
        owner["tasks"].append(task)
    limit_stops(sessions, usage_view(now) if usage is None else usage, now)
    for session in sessions:
        turn = turns.get(session_key(session["agent"], session))
        timed = [t for t in session["tasks"] if t.get("due")]
        if session.get("resume_at"):
            session.update(due=session["resume_at"], eta_source="limit", turn_label=None,
                           eta_started=session.get("since"))
        elif turn and turn.get("due"):
            session.update(due=turn["due"], eta_source="turn", turn_label=turn.get("label") or None,
                           eta_started=turn.get("started"))
        elif timed:
            last = max(timed, key=lambda task: task["due"])
            session.update(due=last["due"], eta_source="tasks", turn_label=None, eta_started=last.get("started"))
        else:
            session.update(due=None, eta_source=None, turn_label=turn.get("label") if turn else None,
                           eta_started=None)
        session["remaining"] = int(session["due"] - now) if session["due"] else None
        session["overdue"] = session["remaining"] is not None and session["remaining"] < 0
        session["progress"] = progress(session["eta_started"], session["due"], now)
    tasks[:] = kept
    return sorted(sessions, key=lambda session: (dormant(session, now), session_sort_key(session)))


def limit_stops(sessions, usage, now):
    """Mark every session that does not work while its account has a reached usage limit as
    stopped until that limit resets, as Codex marks a thread whose turn hit one. A working
    session stays as it is, since it may run on extra usage or the reading may lag behind a
    reset. A dormant one stays dormant, and one already stopped with a reset of its own keeps
    that one."""
    blocked = {agent: summary["resets_at"] for agent, summary, _ in usage_sections(usage)[1]}
    for session in sessions:
        resets_at = blocked.get(agent_label(session["agent"], session.get("account")))
        if (resets_at and session["state"] != "working" and not session.get("resume_at")
                and not dormant(session, now)):
            session.update(state="stopped", waiting_for="usage limit", resume_at=resets_at)


def stopped_before(session, task):
    """Whether a Codex command was started in a turn that has since failed. Codex polls such a
    command no more, so it is over even while its app-server lives on."""
    return (session["state"] == "stopped" and (task.get("holder") or {}).get("type") == "pair"
            and (task.get("started") or 0) <= (session.get("since") or 0))


def session_sort_key(session):
    """By how soon a session needs you. Waiting for an answer first, then at rest with the most
    recently active first, then working by its ETA like the tasks, then stopped until a usage
    limit resets."""
    if session["state"] == "waiting":
        rank = 0
    elif at_rest(session) and not session["tasks"]:
        rank = 1
    elif session["state"] == "stopped":
        rank = 3
    else:
        rank = 2
    remaining = session["remaining"]
    if remaining is None:
        return (rank, 2, -(session.get("since") or 0) if rank == 1 else session.get("since") or 0)
    return (rank, 0 if remaining < 0 else 1, remaining)


def at_rest(session):
    """Idle, or stopped by an error with no reset left to wait for. Nothing runs either way."""
    return session["state"] == "idle" or (session["state"] == "stopped" and not session.get("due"))


def dormant(session, now):
    return (at_rest(session) and not session["tasks"]
            and now - (session.get("since") or now) > DORMANT_AFTER)


def render_sessions(sessions, now, show_dormant=False):
    """The session table, in sections split by a `---` line. Sessions that need you, waiting
    or idle, come first, then working ones, then those stopped until a usage limit resets,
    then dormant ones. An empty section says so in a line of its own, and dormant sessions
    are only counted unless show_dormant asks for them."""
    active = [s for s in sessions if not dormant(s, now)]
    resting = [s for s in sessions if dormant(s, now)]
    groups = [[s for s in active if section(s) == index] for index in range(3)] + [resting]
    blocks = [session_lines(group, now)[1:] for group in groups]
    if resting and not show_dormant:
        blocks[3] = []
    header = session_lines([], now)
    widths = [max(len(line[i]) for line in header + sum(blocks, [])) for i in range(5)]
    def row(line):
        return "  ".join(cell.ljust(widths[i]) for i, cell in enumerate(line[:5])) + "  " + line[5]
    text = [row(header[0])]
    for index, block in enumerate(blocks):
        if index:
            text.append(SECTION_RULE)
        if block:
            text.extend(row(line) for line in block)
        elif index == 3 and resting:
            text.append("%d dormant session%s, idle for more than %s. agent-eta --all lists %s." % (
                len(resting), "" if len(resting) == 1 else "s", "%dh" % (DORMANT_AFTER // 3600),
                "it" if len(resting) == 1 else "them"))
        else:
            text.append(EMPTY_SECTIONS[index])
    return "\n".join(text) + "\n"


def section(session):
    """0 for a session that needs you, 1 for a working one, 2 for one stopped by a usage limit,
    its own or its account's."""
    return max(session_sort_key(session)[0] - 1, 0)


def session_lines(sessions, now):
    lines = [("STATE", "FOR", "REMAINING", "DUE", "AGENT", "SESSION")]
    for session in sessions:
        state = session["state"]
        held = format_span(now - session["since"]) if session.get("since") and state != "-" else "-"
        text = clip(session["name"])
        if session.get("turn_label"):
            text += " · " + session["turn_label"]
        if session.get("waiting_for"):
            text += " (%s)" % session["waiting_for"]
        if session["due"]:
            remaining = format_span(session["remaining"])
        elif at_rest(session):
            remaining = "0"
        elif state == "working":
            remaining = "?"
        else:
            remaining = "-"
        lines.append((state, held, remaining, due_cell(remaining, session["due"], now),
                      agent_label(session["agent"], session.get("account")) or "-", text))
        for task in session["tasks"]:
            left = format_span(task["remaining"])
            lines.append(("", "", left, due_cell(left, task.get("due"), now), "",
                          "└ " + (task.get("label") or "-")))
    return lines


def project_root(cwd, projects=None):
    """The project a working directory belongs to. Below PROJECTS_ROOT that is the directory at
    its first level, since PhpStorm opens a project there and never a subdirectory, elsewhere the
    nearest directory with a `.git`, and otherwise the working directory itself."""
    if not cwd:
        return None
    path = os.path.abspath(cwd)
    base = os.path.abspath(os.path.expanduser(projects or PROJECTS_ROOT))
    inner = os.path.relpath(path, base)
    if inner != os.curdir and inner != os.pardir and not inner.startswith(os.pardir + os.sep):
        return os.path.join(base, inner.split(os.sep)[0])
    probe = path
    # A worktree's .git is a file. An empty .git directory, as one in /tmp, is no repository.
    while not (os.path.isfile(os.path.join(probe, ".git"))
               or os.path.isfile(os.path.join(probe, ".git", "HEAD"))):
        parent = os.path.dirname(probe)
        if parent == probe:
            return path
        probe = parent
    return probe


def project_name(root):
    """The name PhpStorm shows for a project, which leads its window titles. It is the one in
    `.idea/.name` after a rename, and the directory name otherwise."""
    if not root:
        return None
    try:
        with open(os.path.join(root, ".idea", ".name"), "r", encoding="utf-8") as handle:
            name = handle.read().strip()
    except (OSError, UnicodeDecodeError):
        name = ""
    return name or os.path.basename(root.rstrip(os.sep))


def session_json(session, now):
    """A session as --json prints it. Its tasks are named by id, and besides the session view it
    carries what the tray widget needs: whether it is dormant, its section in the order of the
    session table, the process lineage to find its window by and the project it works in. A Codex
    thread has no process of its own, since the tray opens it by its id."""
    pid = None
    if session["agent"] != "codex":
        holders = [(t.get("holder") or {}) for t in session["tasks"]]
        pid = session.get("pid") or next((h.get("pid") for h in holders if h.get("type") == "pid"), None)
    root = project_root(session.get("cwd"))
    session["dormant"] = dormant(session, now)
    session["section"] = DORMANT_SECTION if session["dormant"] else section(session)
    session["pids"] = lineage(int(pid)) if pid else []
    session["project_root"] = root
    session["project_name"] = project_name(root)
    session["tasks"] = [task["id"] for task in session["tasks"]]
    return session


def cmd_list(args):
    now = time.time()
    directory = state_dir()
    table = rows(directory, now)
    usage = usage_view(now)
    # The session view also deletes tasks that ended unseen, so --tasks runs it as well.
    sessions = sessions_view(directory, now, table, usage)
    if args.json:
        sessions = [session_json(session, now) for session in sessions]
        json.dump({"now": int(now), "sessions": sessions, "tasks": table, "usage": usage}, sys.stdout,
                  indent=2, sort_keys=True)
        sys.stdout.write("\n")
    elif args.tasks:
        sys.stdout.write(render(table, now))
    else:
        # A blank line sets the usage table apart, since `---` only splits sections inside a table.
        sys.stdout.write(render_sessions(sessions, now, args.all) + "\n" + render_usage(usage, now))
    return 0


# --- hook -----------------------------------------------------------------------------

def trace(directory, *fields):
    """One line per hook call in hook.log, without any command text."""
    try:
        path = os.path.join(directory, "hook.log")
        try:
            if os.path.getsize(path) > HOOK_LOG_MAX:
                os.replace(path, path + ".1")
        except OSError:
            pass
        stamp = datetime.now(BERLIN).strftime("%Y-%m-%d %H:%M:%S")
        with open(path, "a", encoding="utf-8") as handle:
            handle.write("\t".join([stamp] + [str(f) for f in fields]) + "\n")
    except OSError:
        pass


def hook_command(payload):
    command = (payload.get("tool_input") or {}).get("command")
    if isinstance(command, list):
        command = " ".join(str(part) for part in command)
    return str(command or "")


def claude_post(directory, payload):
    response = payload.get("tool_response")
    if not isinstance(response, dict) or not response.get("backgroundTaskId"):
        return "foreground"
    task = safe_id(response["backgroundTaskId"])
    command = hook_command(payload)
    if _WRAPPED.search(command):
        return "wrapped"
    found = find_task_pid(task)
    if not found:
        return "already-exited"
    description = str((payload.get("tool_input") or {}).get("description") or "")
    eta = find_eta(description) or find_eta(command)
    pid = claude_pid()
    record = claude_session(pid) if pid else {}
    session = {"id": payload.get("session_id"), "pid": pid, "name": record.get("name")}
    label = strip_eta(description) if description else command_label(command)
    entry = make_entry("claude-" + task, "claude", label or command_label(command),
                       eta[0] if eta else None,
                       {"type": "pid", "pid": found[0], "start": found[1]},
                       "hook", session, payload.get("cwd"))
    write_atomic(entry_path(directory, entry["id"]), entry)
    return "recorded"


def codex_pre(directory, payload):
    use_id = payload.get("tool_use_id")
    if not use_id:
        return "no-tool-use-id"
    command = hook_command(payload)
    if _WRAPPED.search(command):
        return "wrapped"
    eta = find_eta(command)
    app = ancestor(lambda pid: comm_of(pid) == "codex")
    holder = {"type": "pair", "app": {"pid": app, "start": proc_start(app)} if app else {}}
    session = {"id": payload.get("session_id")}
    entry = make_entry("codex-" + safe_id(use_id), "codex", command_label(command),
                       eta[0] if eta else None, holder, "hook", session, payload.get("cwd"))
    write_atomic(entry_path(directory, entry["id"]), entry)
    return "recorded"


def codex_post(directory, payload):
    use_id = payload.get("tool_use_id")
    if not use_id:
        return "no-tool-use-id"
    return "removed" if remove(entry_path(directory, "codex-" + safe_id(use_id))) else "unknown"


def codex_state(directory, payload, state, waiting_for=None, now=None):
    """Record the state of a Codex thread. `since` moves only when the state changes."""
    thread = payload.get("session_id")
    if not thread:
        return "no-session-id"
    now = time.time() if now is None else now
    path = codex_session_path(directory, thread)
    record = read_json(path) or {}
    if record.get("state") != state or record.get("waiting_for") != waiting_for:
        record["since"] = int(now)
    record.update({"version": 1, "agent": "codex", "id": thread, "state": state, "waiting_for": waiting_for,
                   "updated": int(now), "cwd": payload.get("cwd") or record.get("cwd"),
                   "transcript": payload.get("transcript_path") or record.get("transcript")})
    app = ancestor(lambda pid: comm_of(pid) == "codex")
    if app:
        record["app"] = {"pid": app, "start": proc_start(app)}
    write_atomic(path, record)
    return state


def codex_event(directory, payload):
    event = payload.get("hook_event_name")
    thread = payload.get("session_id")
    actions = []
    if event in ("PreToolUse", "PostToolUse"):
        if payload.get("tool_name") != "Bash":
            actions.append("not-bash")
        elif event == "PreToolUse":
            actions.append(codex_pre(directory, payload))
        else:
            actions.append(codex_post(directory, payload))
    if event in TURN_ENDS and thread and remove(turn_path(directory, "codex", {"id": thread})):
        actions.append("turn-cleared")
    if event == "SessionEnd" and thread:
        remove(codex_session_path(directory, thread))
        actions.append("ended")
    elif event in CODEX_STATES:
        state = CODEX_STATES[event]
        actions.append(codex_state(directory, payload, state, "permission" if state == "waiting" else None))
    return "+".join(actions) or "ignored"


def claude_env():
    return bool(os.environ.get("CLAUDECODE") or os.environ.get("CLAUDE_PID"))


def is_codex(payload):
    """The payload decides first. Codex sends turn_id and keeps its transcripts under
    ~/.codex, while Claude Code does neither, and an environment variable could leak from
    whatever started the app. Interrupt and SessionEnd may carry neither, and Claude Code
    has no hook here for them."""
    if "turn_id" in payload or "/.codex/" in str(payload.get("transcript_path") or ""):
        return True
    return not claude_env() and payload.get("hook_event_name") in ("Interrupt", "SessionEnd", "PermissionRequest")


def handle_hook(directory, payload):
    event = payload.get("hook_event_name")
    if is_codex(payload):
        return "codex", event, codex_event(directory, payload)
    if claude_env():
        if payload.get("tool_name") != "Bash":
            return "claude", event, "not-bash"
        if event == "PostToolUse":
            return "claude", event, claude_post(directory, payload)
        return "claude", event, "ignored"
    return "unknown", event, "ignored"


def cmd_hook(args):
    directory = None
    try:
        directory = state_dir()
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else {}
        if not isinstance(payload, dict):
            raise ValueError("payload is not an object")
        agent, event, action = handle_hook(directory, payload)
        trace(directory, event, agent, payload.get("session_id") or "-",
              payload.get("tool_use_id") or "-", action)
    except Exception as exc:  # A hook that fails would surface in every tool call.
        if directory:
            trace(directory, "error", type(exc).__name__)
    return 0


# --- run, add, done -------------------------------------------------------------------

def cmd_run(args):
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        print("agent-eta run: no command given", file=sys.stderr)
        return 2
    agent, session = current_session()
    directory = state_dir()
    entry = make_entry("run-" + secrets.token_hex(4), args.agent or agent,
                       args.label or " ".join(command), args.eta, {"type": "lock"}, "run", session)
    path = entry_path(directory, entry["id"])
    lock = write_locked(path, entry)
    try:
        try:
            # Its own process group, so a Ctrl+C reaches the child once, through the
            # forwarding below, rather than twice.
            child = subprocess.Popen(command, process_group=0)
        except FileNotFoundError:
            print("agent-eta run: %s: command not found" % command[0], file=sys.stderr)
            return 127
        except PermissionError:
            print("agent-eta run: %s: permission denied" % command[0], file=sys.stderr)
            return 126

        def forward(signum, _frame):
            try:
                child.send_signal(signum)
            except ProcessLookupError:
                pass

        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, forward)
        code = child.wait()
        return code if code >= 0 else 128 - code
    finally:
        remove(path)
        lock.close()


def cmd_add(args):
    agent, session = current_session()
    holder = None
    if args.pid is not None:
        start = proc_start(args.pid)
        if start is None:
            print("agent-eta add: no process %d" % args.pid, file=sys.stderr)
            return 1
        holder = {"type": "pid", "pid": args.pid, "start": start}
    entry = make_entry("add-" + secrets.token_hex(4), args.agent or agent, args.label, args.eta,
                       holder, "add", session)
    write_atomic(entry_path(state_dir(), entry["id"]), entry)
    print(entry["id"])
    return 0


def cmd_done(args):
    directory = state_dir()
    missing = [entry_id for entry_id in args.ids if not remove(entry_path(directory, safe_id(entry_id)))]
    for entry_id in missing:
        print("agent-eta done: no entry %s" % entry_id, file=sys.stderr)
    return 1 if missing else 0


def cmd_turn(args):
    agent, session = current_session()
    if agent not in ("claude", "codex") or session_key(agent, session) is None:
        print("agent-eta turn: not called from a Claude Code or Codex session", file=sys.stderr)
        return 1
    path = turn_path(state_dir(), agent, session)
    if args.done:
        remove(path)
        return 0
    if args.eta is None:
        print("agent-eta turn: --eta or --done is required", file=sys.stderr)
        return 2
    write_atomic(path, make_entry("turn", agent, args.label or "", args.eta, None, "turn", session))
    return 0


# --- main -----------------------------------------------------------------------------

def eta_type(text):
    try:
        return parse_eta_arg(text)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(str(exc))


def build_parser():
    parser = argparse.ArgumentParser(prog="agent-eta", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="cmd")
    listing = sub.add_parser("list", help="print every running session with its state, ETA and tasks")
    listing.add_argument("--json", action="store_true", help="machine-readable output")
    listing.add_argument("--tasks", action="store_true", help="the flat task list instead of the sessions")
    listing.add_argument("--all", action="store_true", help="also list dormant sessions, idle for more than 12h")
    sub.add_parser("hook", help="hook entry point for Claude Code and Codex")
    run = sub.add_parser("run", help="run a command and list it while it runs")
    run.add_argument("--eta", type=eta_type, required=True, help="25m, 1h30m, 7200, ca. 10 minutes")
    run.add_argument("--label")
    run.add_argument("--agent")
    run.add_argument("command", nargs=argparse.REMAINDER)
    add = sub.add_parser("add", help="record a wait that is not a local process")
    add.add_argument("--eta", type=eta_type, required=True)
    add.add_argument("--label", required=True)
    add.add_argument("--agent")
    add.add_argument("--pid", type=int)
    turn = sub.add_parser("turn", help="set or clear the ETA of the calling session's current turn")
    turn.add_argument("--eta", type=eta_type)
    turn.add_argument("--label")
    turn.add_argument("--done", action="store_true")
    done = sub.add_parser("done", help="remove entries recorded with add")
    done.add_argument("ids", nargs="+")
    return parser


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("--json", "--tasks", "--all"):
        argv.insert(0, "list")
    args = build_parser().parse_args(argv)
    handlers = {"list": cmd_list, "hook": cmd_hook, "run": cmd_run, "add": cmd_add, "done": cmd_done,
                "turn": cmd_turn}
    try:
        return handlers[args.cmd](args)
    except StateDirError as exc:
        print("agent-eta: %s" % exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
